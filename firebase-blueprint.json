{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin", "technician"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Appliance": {
      "title": "Appliance",
      "description": "A registered home appliance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "type": { "type": "string", "enum": ["AC", "Refrigerator", "Washing Machine", "Dishwasher", "Microwave", "Other"] },
        "model": { "type": "string" },
        "brand": { "type": "string" },
        "purchaseDate": { "type": "string", "format": "date" },
        "warrantyUntil": { "type": "string", "format": "date" }
      },
      "required": ["ownerId", "type"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A service appointment booking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "applianceId": { "type": "string" },
        "serviceType": { "type": "string", "enum": ["Repair", "Maintenance", "Installation", "Consultation"] },
        "description": { "type": "string" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in-progress", "completed", "cancelled"] },
        "technicianId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "serviceType", "scheduledAt", "status", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat conversation between a user and support",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "userId": { "type": "string" }
      },
      "required": ["participants", "status", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public and private user profiles"
    },
    "/appliances/{applianceId}": {
      "schema": "Appliance",
      "description": "Registered appliances"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Service bookings"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat metadata"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual chat messages"
    },
    "/admins/{adminId}": {
      "schema": { "type": "object", "properties": { "role": { "type": "string" } } },
      "description": "Admin roles"
    }
  }
}
